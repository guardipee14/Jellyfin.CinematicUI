<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.CinematicUI</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.CinematicUI</RootNamespace>
    <Version>0.1.11.0</Version>
    <AssemblyVersion>0.1.11.0</AssemblyVersion>
    <FileVersion>0.1.11.0</FileVersion>
    <Authors>Donaven Guardipee</Authors>
    <Company>Cinematic UI</Company>
    <Description>Cinematic login and Plex-inspired Jellyfin Web home experience.</Description>
    <RepositoryUrl>https://github.com/guardipee14/Jellyfin.CinematicUI</RepositoryUrl>
    <PackageProjectUrl>https://github.com/guardipee14/Jellyfin.CinematicUI</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Include="Web/cinematic.css" />
    <EmbeddedResource Include="Web/client.js" />
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>
</Project>
